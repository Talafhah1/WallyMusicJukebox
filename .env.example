# WallyMusicJukebox Build Configuration
# Copy this file to .env and customize for your setup

# Wwise SDK Configuration
WWISE_SDK_PATH=C:/Program Files (x86)/Audiokinetic/Wwise 2017.2.10.6745
WWISE_SDK_VERSION=2017.2.10.6745

# Build Configuration
# Options: "Visual Studio 17 2022", "Visual Studio 16 2019", "MinGW Makefiles", "Ninja"
CMAKE_GENERATOR=Visual Studio 17 2022
BUILD_ARCH=x64
BUILD_CONFIG=Release

# Optional: Visual Studio version (vc140, vc150, vc160, etc.)
# For MinGW/GCC, this is typically vc140 or vc150 depending on compatibility
WWISE_VC_VERSION=vc150

# For MinGW/GCC builds - set the compiler paths
# Uncomment and set these if using MinGW/GCC
# CXX=C:/msys64/mingw64/bin/g++.exe
# CC=C:/msys64/mingw64/bin/gcc.exe
